{
  "name": "dsh-memory-nebula",
  "version": "1.7.0",
  "private": false,
  "description": "Local-first memory nebula for DeepSeek Harness — read-only graph, spreading recall, evidence chains, offline snapshots. 记忆星图：把 DSH 各工作区的记忆只读连成一张可交互星云。",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "memory-nebula": "lib/standalone.mjs",
    "memory-nebula-doctor": "scripts/doctor.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "scripts",
    "sidecar.ps1",
    "locale",
    "market",
    "SECURITY.md",
    "SUPPORT.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "bench": "node --expose-gc scripts/bench.mjs",
    "check": "node scripts/release-check.mjs",
    "standalone": "node lib/standalone.mjs",
    "start": "node lib/standalone.mjs",
    "verify": "npm test && npm run check",
    "prepack": "npm run verify",
    "doctor": "node scripts/doctor.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "nebula",
    "graph",
    "relational-memory",
    "spreading-activation",
    "memory-adapter",
    "visualization",
    "dsh",
    "memory-graph",
    "knowledge-graph",
    "offline-snapshot"
  ],
  "author": "主人 & 小代码酱",
  "homepage": "https://github.com/hanhan9999999999999999999/dsh-memory-nebula#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanhan9999999999999999999/dsh-memory-nebula.git"
  },
  "bugs": {
    "url": "https://github.com/hanhan9999999999999999999/dsh-memory-nebula/issues"
  }
}
